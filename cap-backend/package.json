{
  "name": "Tensor",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "express-rate-limit": "^7",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "dev": "cds watch",
    "build": "cds build --production"
  },
  "private": true,
  "cds": {
    "server": {
      "body_parser": {
        "limit": "50mb"
      }
    },
    "fiori": {
      "bypass_draft": true
    },
    "requires": {
      "db": {
        "kind": "hana-cloud",
        "pool": {
          "min": 5,
          "max": 50,
          "acquireTimeoutMillis": 30000,
          "idleTimeoutMillis": 60000,
          "evictionRunIntervalMillis": 10000
        }
      },
      "auth": {
        "kind": "xsuaa"
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[development]": {
        "db": {
          "kind": "sqlite"
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "admin",
                "authenticated-user"
              ]
            },
            "alice": {
              "password": "alice",
              "roles": [
                "authenticated-user"
              ]
            }
          }
        }
      }
    }
  }
}

