{
  "xsappname": "tender-cap",
  "tenant-mode": "dedicated",
  "description": "Security config for TenderFlow CAP application",
  "scopes": [
    {
      "name": "$XSAPPNAME.admin",
      "description": "Admin access"
    },
    {
      "name": "$XSAPPNAME.authenticated-user",
      "description": "Authenticated user access"
    }
  ],
  "role-templates": [
    {
      "name": "admin",
      "description": "Full admin access",
      "scope-references": [
        "$XSAPPNAME.admin",
        "$XSAPPNAME.authenticated-user"
      ]
    },
    {
      "name": "reviewer",
      "description": "Reviewer access",
      "scope-references": [
        "$XSAPPNAME.authenticated-user"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "TenderFlow Admin",
      "description": "TenderFlow administrators",
      "role-template-references": [
        "$XSAPPNAME.admin"
      ]
    },
    {
      "name": "TenderFlow Reviewer",
      "description": "TenderFlow reviewers",
      "role-template-references": [
        "$XSAPPNAME.reviewer"
      ]
    }
  ]
}
